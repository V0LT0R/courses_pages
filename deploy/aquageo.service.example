[Unit]
Description=AQUAGEO course API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=aquageo
Group=aquageo
WorkingDirectory=/srv/aquageo
EnvironmentFile=/etc/aquageo/backend.env
ExecStart=/usr/bin/node /srv/aquageo/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
[Install]
WantedBy=multi-user.target
