{
  "name": "aquageo-seminars",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run dev:client\"",
    "build": "node scripts/preflight.mjs && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:full": "npm run dev",
    "preflight": "node scripts/preflight.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/http/*.test.mjs tests/database/*.test.mjs",
    "test:supabase": "node tests/integration/supabase-smoke.mjs",
    "test:concurrency": "node tests/integration/concurrency.mjs",
    "test:local": "npm run preflight && npm test",
    "verify:release": "npm run preflight && npm run lint && npm run scan:release && npm test && npm run sql:check && npm run build",
    "start:checked": "npm run preflight && npm test && npm run build && npm run dev",
    "dev:client": "vite",
    "lint": "eslint .",
    "sql:build": "node scripts/build-sql.mjs",
    "sql:check": "node scripts/sql-check.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/database/*.test.mjs tests/http/*.test.mjs",
    "start": "node server/index.js",
    "scan:release": "node scripts/release-scan.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
