# FRONTEND-SAFE. Included in the browser build: only project URL and publishable/anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
VITE_API_URL=/api

# BACKEND ONLY. NEVER prefix any secret with VITE_. Use a separate backend environment in production.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Site origin, with /api and /verify routed to Express. HTTPS domain is required in production.
PUBLIC_APP_URL=http://localhost:5173
CERT_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# 0 for direct connections; 1 only when exactly one trusted proxy is the only path to Node.
TRUST_PROXY=0
# Issuer is stored in public.app_settings; change it with SQL, see README. Existing snapshots stay unchanged.

# OPTIONAL, only for manual import utility. The normal server needs no DATABASE_URL/JWT/Ed25519 keys.
# LEGACY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# OPTIONAL test environment. Never put production database credentials here.
# TEST_DATABASE_URL=postgresql://postgres:local_disposable_test_only@127.0.0.1:55432/aquageo_test
# ALLOW_TEST_WRITES=YES
# TEST_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
# TEST_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLIC_KEY
